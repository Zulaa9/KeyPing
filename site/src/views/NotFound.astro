---
// GitHub Pages sirve un único /404.html para cualquier ruta inexistente, así que es bilingüe.
import Base from '../layouts/Base.astro';
import { ROUTES } from '../i18n/routes';
---
<Base lang="es" page="notFound" title="Página no encontrada · Page not found · KeyPing" description="Esta página no existe. This page does not exist.">
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Esta página no existe</h1>
      <p class="lead">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="actions">
        <a class="btn btn-primary" href={ROUTES.es.home}>Ir al inicio</a>
        <a class="btn btn-secondary" href={ROUTES.es.download}>Descargar KeyPing</a>
      </div>
      <div lang="en" class="notfound-en">
        <h2>This page does not exist</h2>
        <p class="lead">The link may be mistyped or the page may have moved.</p>
        <div class="actions">
          <a class="btn btn-primary" href={ROUTES.en.home} hreflang="en">Go to the home page</a>
          <a class="btn btn-secondary" href={ROUTES.en.download} hreflang="en">Download KeyPing</a>
        </div>
      </div>
    </div>
  </section>
</Base>
