---
import Base from '../layouts/Base.astro';
import { getRelease, LATEST_URL, RELEASES_URL } from '../lib/release';
import { ROUTES, STORE_URL, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const rel = await getRelease();
const r = ROUTES[lang];
const fmtSize = (b: number) => new Intl.NumberFormat(es ? 'es-ES' : 'en-GB', { maximumFractionDigits: 0 }).format(b / 1_000_000) + ' MB';
const fmtDate = (iso: string) => new Intl.DateTimeFormat(es ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' }).format(new Date(iso));
const android = rel.android;
const title = es
  ? `Descargar KeyPing ${rel.version} para Windows, Linux${android ? ' y Android' : ''}`
  : `Download KeyPing ${rel.version} for Windows, Linux${android ? ' and Android' : ''}`;
const description = es
  ? `Descarga KeyPing ${rel.version}: instalador para Windows, AppImage para Linux${android ? ' y APK para Android' : ''}, con su SHA-256 y cómo comprobarlo.`
  : `Download KeyPing ${rel.version}: Windows installer, Linux AppImage${android ? ' and Android APK' : ''}, with their SHA-256 and how to check them.`;
const platforms = [
  { key: 'windows', name: 'Windows', kind: es ? 'Microsoft Store o instalador (.exe), Windows 10 y 11 de 64 bits' : 'Microsoft Store or installer (.exe), 64-bit Windows 10 and 11', a: rel.windows },
  { key: 'linux', name: 'Linux', kind: es ? 'AppImage de 64 bits (x86_64)' : '64-bit AppImage (x86_64)', a: rel.linux },
  ...(android ? [{ key: 'android', name: 'Android', kind: es ? 'APK para Android 7 o superior' : 'APK for Android 7 or later', a: android }] : []),
];
---
<Base lang={lang} page="download" title={title} description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">{es ? 'Descargas' : 'Downloads'}</p>
      <h1>{es ? `Descargar KeyPing ${rel.version}` : `Download KeyPing ${rel.version}`}</h1>
      <p class="lead">{es ? `Publicada el ${fmtDate(rel.publishedAt)}. Gratis, sin registro y sin anuncios.` : `Released on ${fmtDate(rel.publishedAt)}. Free, no sign-up and no ads.`}</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <div class="platforms">
        {platforms.map((p) => (
          <article class="platform" data-platform-card={p.key} aria-labelledby={`pf-${p.key}`}>
            <span class="detected-badge">{es ? '✓ Tu sistema' : '✓ Your system'}</span>
            <h2 id={`pf-${p.key}`}>{p.name}</h2>
            <p class="muted">{p.kind}</p>
            <dl>
              <dt>{es ? 'Archivo' : 'File'}</dt><dd><code>{p.a.name}</code></dd>
              <dt>{es ? 'Versión' : 'Version'}</dt><dd>{rel.version}</dd>
              <dt>{es ? 'Fecha' : 'Date'}</dt><dd>{fmtDate(rel.publishedAt)}</dd>
              <dt>{es ? 'Tamaño' : 'Size'}</dt><dd>{fmtSize(p.a.size)}</dd>
              {p.a.sha256 && (<><dt>SHA-256</dt><dd class="hash">{p.a.sha256}</dd></>)}
            </dl>
            {p.key === 'windows' ? (
              <p class="platform-actions">
                <a class="btn btn-primary" href={STORE_URL}>{es ? 'Obtener en Microsoft Store' : 'Get it from Microsoft Store'}</a>
                <a class="btn" href={p.a.url} download={p.a.name}>{es ? 'Descargar el instalador .exe' : 'Download the .exe installer'}</a>
              </p>
            ) : (
              <p><a class="btn btn-primary" href={p.a.url} download={p.a.name}>{es ? `Descargar para ${p.name}` : `Download for ${p.name}`}</a></p>
            )}
          </article>
        ))}
      </div>
      <p class="small muted">
        {rel.sumsUrl && (<><a href={rel.sumsUrl} download="SHA256SUMS.txt">SHA256SUMS.txt</a> · </>)}
        <a href={rel.url}>{es ? `Notas de la versión ${rel.version}` : `Release notes for ${rel.version}`}</a>{' · '}
        <a href={RELEASES_URL}>{es ? 'Versiones anteriores' : 'Previous versions'}</a>
      </p>
      {!android && (
        <p class="small muted" data-android-soon>{es
          ? 'Android: la app móvil está en desarrollo y se publicará aquí como APK. Usará el mismo archivo .kpenc para pasar las contraseñas entre ordenador y móvil.'
          : 'Android: the mobile app is in development and will be published here as an APK. It will use the same .kpenc file to move passwords between computer and phone.'}</p>
      )}
      <p class="small muted">{es ? 'macOS y iPhone: no hay versión publicada por ahora.' : 'macOS and iPhone: there is no published build at the moment.'}</p>
    </div>
  </section>

  <section class="section-alt" aria-labelledby="verify-h">
    <div class="wrap prose">
      <h2 id="verify-h"><span id={es ? 'verificar' : 'verify'}>{es ? 'Comprueba la descarga' : 'Check your download'}</span></h2>
      <p>{es
        ? 'Cada release incluye SHA256SUMS.txt con el SHA-256 de cada instalador. Compáralo antes de instalar: si no coincide, no ejecutes el archivo.'
        : 'Each release includes SHA256SUMS.txt with the SHA-256 of every installer. Compare it before installing: if it does not match, do not run the file.'}</p>
      <h3>Windows (PowerShell)</h3>
      <pre><code>Get-FileHash .\{rel.windows.name} -Algorithm SHA256</code></pre>
      <p>{es ? 'El resultado debe ser igual (sin importar mayúsculas) al de la línea del instalador en SHA256SUMS.txt' : 'The result must match (ignoring case) the installer’s line in SHA256SUMS.txt'}{rel.windows.sha256 ? (es ? ' y al valor mostrado arriba.' : ' and the value shown above.') : '.'}</p>
      <h3>Linux</h3>
      <p>{es ? 'Descarga SHA256SUMS.txt en la misma carpeta que el AppImage y ejecuta:' : 'Download SHA256SUMS.txt to the same folder as the AppImage and run:'}</p>
      <pre><code>sha256sum -c --ignore-missing SHA256SUMS.txt</code></pre>
      <p>{es ? <>Debe responder <code>{rel.linux.name}: OK</code>.</> : <>It must print <code>{rel.linux.name}: OK</code>.</>}</p>
      {android && (<>
        <h3>Android</h3>
        <p>{es ? 'En el ordenador, con el APK y SHA256SUMS.txt en la misma carpeta, usa los mismos comandos de arriba. En el móvil, compara el SHA-256 con una app de sumas de comprobación antes de instalar.' : 'On a computer, with the APK and SHA256SUMS.txt in the same folder, use the same commands as above. On the phone, compare the SHA-256 with a checksum app before installing.'}</p>
      </>)}
      <p>{es ? 'Las actualizaciones posteriores las verifica la propia app con una firma Ed25519. ' : 'Later updates are verified by the app itself with an Ed25519 signature. '}<a href={r.security + (es ? '#actualizaciones' : '#updates')}>{es ? 'Más detalles' : 'More details'}</a>.</p>
    </div>
  </section>

  <section aria-labelledby="install-h">
    <div class="wrap prose">
      <h2 id="install-h">{es ? 'Instalación' : 'Installation'}</h2>
      <h3>Windows</h3>
      <p>{es
        ? <>La forma recomendada es <a href={STORE_URL}>Microsoft Store</a>: el paquete lo firma Microsoft, Windows no muestra avisos al instalarlo y las actualizaciones llegan a través de la Store. Esa versión no se conecta a internet. Guarda sus datos aparte de la versión .exe y los elimina al desinstalarla, así que exporta antes una copia cifrada (.kpenc) si vas a desinstalarla o a cambiar de versión.</>
        : <>The recommended way is <a href={STORE_URL}>Microsoft Store</a>: Microsoft signs the package, Windows shows no warnings when installing it and updates arrive through the Store. That version does not connect to the internet. It keeps its data separate from the .exe version and removes it when uninstalled, so export an encrypted backup (.kpenc) first if you are going to uninstall it or switch versions.</>}</p>
      <p>{es
        ? 'Si prefieres el instalador .exe, ejecútalo y sigue los pasos. Como no lleva firma de código, Windows puede mostrar «Windows protegió su PC» (SmartScreen). Si has comprobado el SHA-256, pulsa «Más información» y después «Ejecutar de todas formas».'
        : 'If you prefer the .exe installer, run it and follow the steps. Because it is not code-signed, Windows may show “Windows protected your PC” (SmartScreen). If you have checked the SHA-256, click “More info” and then “Run anyway”.'}</p>
      <h3>Linux</h3>
      <p>{es ? 'El AppImage no necesita instalación. Dale permiso de ejecución y ábrelo:' : 'The AppImage needs no installation. Make it executable and open it:'}</p>
      <pre><code>chmod +x {rel.linux.name}
./{rel.linux.name}</code></pre>
      <p>{es
        ? 'También puedes marcar «Permitir ejecutar el archivo como un programa» en sus propiedades desde el gestor de archivos. Si no arranca, puede que tu distribución necesite la biblioteca FUSE 2 (en Ubuntu, el paquete libfuse2 o libfuse2t64), que usan los AppImage.'
        : 'You can also tick “Allow executing file as program” in its properties from your file manager. If it does not start, your distribution may need the FUSE 2 library (on Ubuntu, the libfuse2 or libfuse2t64 package), which AppImages use.'}</p>
      {android && (<>
        <h3>Android</h3>
        <p>{es
          ? 'Abre el APK descargado en el móvil. Android pedirá permitir instalar apps de esa fuente (el navegador o el gestor de archivos): concédelo solo para esta instalación. La app no tiene permiso de internet y guarda la bóveda cifrada solo en el teléfono. Para traer tus contraseñas, exporta un .kpenc en el ordenador y elige «Restaurar desde un archivo .kpenc» al abrir la app.'
          : 'Open the downloaded APK on your phone. Android will ask you to allow installing apps from that source (the browser or file manager): allow it just for this install. The app has no internet permission and keeps the encrypted vault on the phone only. To bring your passwords over, export a .kpenc on your computer and choose “Restore from a .kpenc file” when you open the app.'}</p>
        <p>{es ? 'La app de Android no se actualiza sola: descarga e instala el APK nuevo encima del anterior (tus datos se conservan).' : 'The Android app does not update itself: download and install the new APK over the old one (your data is kept).'}</p>
      </>)}
      <h3>{es ? 'Actualizaciones' : 'Updates'}</h3>
      <p>{es
        ? 'Las versiones .exe y AppImage avisan cuando hay una versión nueva y la instalan al cerrarse si tú la descargas. También puedes descargarla siempre desde '
        : 'The .exe and AppImage versions tell you when a new version is out and install it on exit once you download it. You can also always get it from '}<a href={LATEST_URL}>{es ? 'la última release en GitHub' : 'the latest release on GitHub'}</a>{es ? '. La versión de Microsoft Store se actualiza desde la propia Store.' : '. The Microsoft Store version is updated by the Store itself.'}</p>
    </div>
  </section>
</Base>
