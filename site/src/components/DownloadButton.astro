---
// Botón de descarga. Sin JavaScript enlaza a la página de descargas; /js/site.js lo convierte en
// la descarga directa para Windows o Linux según el navegador y muestra la otra plataforma.
import { getRelease } from '../lib/release';
import { ROUTES, type Lang } from '../i18n/routes';

interface Props { lang: Lang; size?: 'lg' | 'md' }
const { lang, size = 'lg' } = Astro.props;
const rel = await getRelease();
const t = {
  es: {
    generic: 'Descargar KeyPing',
    win: 'Descargar para Windows',
    linux: 'Descargar para Linux',
    otherWin: 'También para Windows (.exe)',
    otherLinux: 'También para Linux (AppImage)',
    all: 'Todas las descargas y cómo verificarlas',
    android: 'Descargar para Android (APK)',
    unsupported: rel.android ? 'KeyPing está disponible para Windows, Linux y Android. No hay versión para macOS ni iPhone.' : 'KeyPing está disponible para Windows y Linux. La versión para Android está en desarrollo; no hay versión para macOS ni iPhone.',
    meta: `Versión ${rel.version} · gratis · código abierto`,
  },
  en: {
    generic: 'Download KeyPing',
    win: 'Download for Windows',
    linux: 'Download for Linux',
    otherWin: 'Also for Windows (.exe)',
    otherLinux: 'Also for Linux (AppImage)',
    all: 'All downloads and how to verify them',
    android: 'Download for Android (APK)',
    unsupported: rel.android ? 'KeyPing is available for Windows, Linux and Android. There is no macOS or iPhone version.' : 'KeyPing is available for Windows and Linux. The Android version is in development; there is no macOS or iPhone version.',
    meta: `Version ${rel.version} · free · open source`,
  },
}[lang];
---
<div class={`download-cta size-${size}`} data-download
  data-win-href={rel.windows.url} data-win-label={t.win} data-win-other={t.otherWin}
  data-linux-href={rel.linux.url} data-linux-label={t.linux} data-linux-other={t.otherLinux}
  data-android-href={rel.android?.url} data-android-label={t.android}>
  <a class="btn btn-primary" href={ROUTES[lang].download} data-primary>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M10 3v9m0 0l-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span data-label>{t.generic}</span>
  </a>
  <p class="download-meta small">
    <span data-meta>{t.meta}</span>
    <a href={ROUTES[lang].download} data-other hidden></a>
  </p>
  <p class="small muted" data-unsupported hidden>{t.unsupported}</p>
  <p class="small"><a href={ROUTES[lang].download} data-all>{t.all}</a></p>
</div>
