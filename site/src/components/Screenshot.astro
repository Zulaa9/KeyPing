---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { lang, name, alt, sizes = '(min-width: 1100px) 640px, 100vw', eager = false, class: cls } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*.png', { eager: true });
const mod = all[`../assets/screens/${lang}/${name}.png`];
if (!mod) throw new Error(`Falta la captura ${lang}/${name}.png`);
---
<Picture
  src={mod.default}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[480, 800, 1280]}
  sizes={sizes}
  quality={78}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class={cls ? `shot ${cls}` : 'shot'}
/>
